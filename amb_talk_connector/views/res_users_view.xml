<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_users_form_inherit">
        <field name="name">res.users.form inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page name="api_auth" string="API Permissions">
                    
                    <group string="API Authentication">
                        <group>
                            <field name="api_domain"/>
                            <label for="api_rest_key"/>
                            <div class="o_row">
                                <field name="api_rest_key"/>
                                <button name="generate_api_rest_key" string="Get API key" class="oe_highlight" type="object"/>
                            </div>
                        </group>
                    </group>
                    
                    <separator/>

                    <group string="  API Endpoints">
                        <group string="Partners">
                            <label for="api_allow_partner" string="Read"  class="fw-bold"/>
                            <div class="o_row">
                                <field name="api_allow_partner"/>

                                <label for="api_allow_partner_create" string="Create"  class="fw-bold"/>
                                <field name="api_allow_partner_create"/>

                                <label for="api_allow_partner_write" string="Write"  class="fw-bold"/>
                                <field name="api_allow_partner_write"/>

                                <label for="api_allow_partner_delete" string="Delete"  class="fw-bold"/>
                                <field name="api_allow_partner_delete"/>
                            </div>
                        </group>

                        <group string="Sale Orders">
                            <label for="api_allow_sale_order" string="Read"  class="fw-bold"/>
                            <div class="o_row">
                                <field name="api_allow_sale_order"/>

                                <label for="api_allow_sale_order_create" string="Create"  class="fw-bold"/>
                                <field name="api_allow_sale_order_create"/>

                                <label for="api_allow_sale_order_write" string="Write"  class="fw-bold"/>
                                <field name="api_allow_sale_order_write"/>

                                <!-- <label for="api_allow_sale_order_delete" string="Delete"  class="fw-bold"/> -->
                                <!-- <field name="api_allow_sale_order_delete"/> -->
                            </div>
                        </group>

                        <group string="Countries &amp; States">
                            <field name="api_allow_countries"/>
                            <field name="api_allow_states"/>
                        </group>


                        <group string="Products">
                            <field name="api_allow_product"/>
                            <field name="api_allow_product_template"/>
                        </group>

                        <group string="Taxes">
                            <field name="api_allow_tax"/>
                        </group>

                    </group>
    
                </page>
            </xpath>
        </field>
    </record>

</odoo>